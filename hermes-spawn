#!/usr/bin/env bash
#
# hermes-spawn — spin up a named Hermes Agent instance in Docker, or remove one.
#
# Usage:  hermes-spawn <name>
#         hermes-spawn restore <name>
#         hermes-spawn dashboard <name> [--disable] [--no-tui] [--oauth] [--insecure] [--reset-auth]
#         hermes-spawn update <name> [--image <ref>] [--no-pull]
#         hermes-spawn remove|rm <name> [--keep-data] [-y|--yes]
# Example: hermes-spawn namely
#          hermes-spawn restore namely
#          hermes-spawn dashboard namely
#          hermes-spawn update namely
#          hermes-spawn remove namely
#
# Behavior: ALL preflight checks run first. If anything is already taken
# or would conflict, the script aborts before touching anything.
# Only after every check passes does it create the data dir, run setup,
# start the container, and append the alias.
#

set -euo pipefail

HERMES_IMAGE="nousresearch/hermes-agent"

# =========================================================================
# Helpers
# =========================================================================

usage_spawn() {
  echo "Usage: $0 <name>" >&2
  echo "       $0 restore <name>" >&2
  echo "       $0 dashboard <name> [--disable] [--no-tui] [--oauth] [--insecure] [--reset-auth]" >&2
  echo "       $0 update <name> [--image <ref>] [--no-pull]" >&2
  echo "       $0 remove|rm <name> [--keep-data] [-y|--yes]" >&2
  echo "Example: $0 namely" >&2
  echo "         $0 restore namely" >&2
  echo "         $0 dashboard namely" >&2
  echo "         $0 update namely" >&2
  echo "         $0 remove namely" >&2
  exit 1
}

# Resolve the data directory for a given instance name.
# Prefers the new location ($HOME/hermes-spawn/<name>); falls back to the
# legacy location ($HOME/.<name>) so old installs still work for `remove`.
resolve_data_dir() {
  local n="$1"
  local new="$HOME/hermes-spawn/$n"
  local old="$HOME/.$n"
  if [[ -e "$new" ]]; then
    echo "$new"
  elif [[ -e "$old" ]]; then
    echo "$old"
  else
    echo "$new"   # canonical path for create flow
  fi
}

# If a legacy data dir exists at $HOME/.<name> and the new path doesn't,
# move it. Called during create so existing users don't end up with two
# data dirs after upgrade.
migrate_legacy_data_dir() {
  local n="$1"
  local new="$HOME/hermes-spawn/$n"
  local old="$HOME/.$n"
  if [[ -d "$old" ]] && [[ ! -e "$new" ]]; then
    echo ">> Found legacy data at $old"
    echo ">> Migrating to $new"
    mkdir -p "$HOME/hermes-spawn"
    mv "$old" "$new"
  fi
}

# Remove our comment+alias block (or a stray matching alias line) from ~/.bashrc.
# Recognizes both legacy alias format (no --user flag) and current format
# (--user hermes), so `remove` works on instances spawned by older versions.
strip_hermes_bashrc_for_name() {
  local n="$1"
  local f="$2"
  local comment="# hermes-spawn: alias for '$n' container"
  local aline_new="alias ${n}='docker exec -it --user hermes ${n} /opt/hermes/.venv/bin/hermes'"
  local aline_old="alias ${n}='docker exec -it ${n} /opt/hermes/.venv/bin/hermes'"
  if [[ ! -f "$f" ]]; then
    return 0
  fi
  local lines=() out=() i=0
  mapfile -t lines < "$f" 2>/dev/null || return 0
  local m=${#lines[@]}
  while ((i < m)); do
    if [[ "${lines[i]}" == "$comment" ]] && ((i + 1 < m)) && { [[ "${lines[i+1]}" == "$aline_new" ]] || [[ "${lines[i+1]}" == "$aline_old" ]]; }; then
      if ((${#out[@]})) && [[ -z "${out[${#out[@]}-1]//[[:space:]]/}" ]]; then
        out=("${out[@]:0:$((${#out[@]}-1))}")
      fi
      i=$((i+2))
      continue
    fi
    if [[ "${lines[i]}" == "$aline_new" ]] || [[ "${lines[i]}" == "$aline_old" ]]; then
      i=$((i+1))
      continue
    fi
    out+=("${lines[i]}")
    i=$((i+1))
  done
  { printf '%s\n' "${out[@]}"; } >"${f}.hermes-spawn.$$" 2>/dev/null || { rm -f "${f}.hermes-spawn.$$" 2>/dev/null; return 0; }
  mv -f "${f}.hermes-spawn.$$" "$f"
}

# Return 0 if ~/.bashrc already has our alias block for $n.
bashrc_has_hermes_spawn_alias() {
  local n="$1"
  local f="${2:-$HOME/.bashrc}"
  local comment="# hermes-spawn: alias for '$n' container"
  local aline_new="alias ${n}='docker exec -it --user hermes ${n} /opt/hermes/.venv/bin/hermes'"
  local aline_old="alias ${n}='docker exec -it ${n} /opt/hermes/.venv/bin/hermes'"
  [[ -f "$f" ]] || return 1
  grep -qF "$comment" "$f" 2>/dev/null && return 0
  grep -qFx "$aline_new" "$f" 2>/dev/null && return 0
  grep -qFx "$aline_old" "$f" 2>/dev/null && return 0
  return 1
}

# Return 0 if $dir looks like an existing Hermes data volume.
hermes_data_dir_looks_valid() {
  local d="$1"
  [[ -f "$d/.env" || -f "$d/config.yaml" ]]
}

# Fix ownership on bind-mounted data (Hermes image workaround).
fix_hermes_data_ownership() {
  local data_dir="$1"
  local image="${2:-$HERMES_IMAGE}"
  echo ">> Fixing ownership on data dir (workaround for Hermes image issue)..."
  docker run --rm \
    --user 0:0 \
    --entrypoint chown \
    -v "$data_dir:/opt/data" \
    "$image" -R 10000:10000 /opt/data
}

# Compute HERMES_UID/HERMES_GID env-var array for docker run, mapping the
# in-container "hermes" user to the host user so bind-mounted files have
# correct ownership. Skip if we can't determine a non-root host user.
compute_hermes_env() {
  local h_uid="" h_gid=""
  if [[ "$(id -u)" -ne 0 ]]; then
    h_uid="$(id -u)"
    h_gid="$(id -g)"
  elif [[ -n "${SUDO_UID-}" ]]; then
    if (( SUDO_UID != 0 )); then
      h_uid="$SUDO_UID"
      h_gid="${SUDO_GID:-$(id -g "${SUDO_USER:-}" 2>/dev/null || true)}"
      [[ -n "$h_gid" ]] || h_gid="$h_uid"
    fi
  fi
  # The image cannot remap "hermes" onto root.
  if [[ -n "$h_uid" ]] && (( h_uid == 0 )); then
    h_uid=""; h_gid=""
  fi
  if [[ -n "$h_gid" ]] && (( h_gid == 0 )); then
    h_gid="${h_uid:-}"
  fi
  HERMES_UID_RESOLVED="$h_uid"
  HERMES_GID_RESOLVED="$h_gid"
}

# Return 0 when a Hermes-style env value means "enabled".
env_truthy() {
  case "$1" in
  1 | true | TRUE | yes | YES | on | ON) return 0 ;;
  esac
  return 1
}

# Return 0 if a TCP port is already listening on the host.
host_port_is_busy() {
  local port="$1"
  ss -ltn 2>/dev/null | awk '{print $4}' | grep -qE "[:.]${port}\$"
}

# Find the lowest free TCP port on the host, starting at $1 (default 8642).
find_free_host_port() {
  local port="${1:-8642}"
  while host_port_is_busy "$port"; do
    port=$((port + 1))
  done
  echo "$port"
}

# Random signing secret so dashboard sessions survive container restarts.
generate_dashboard_secret() {
  if command -v openssl &>/dev/null; then
    openssl rand -base64 32
  else
    head -c 32 /dev/urandom | base64
  fi
}

# Prompt for dashboard username/password (sets INSTANCE_DASH_BASIC_*).
prompt_dashboard_basic_auth() {
  local user="" pass="" pass2=""
  local default_user="${INSTANCE_DASH_BASIC_USER:-admin}"

  if [[ ! -t 0 ]]; then
    echo "Error: dashboard basic auth requires an interactive terminal." >&2
    echo "       Re-run in a TTY, or use --oauth." >&2
    return 1
  fi

  echo ">> Dashboard login (required on current Hermes images when Docker publishes the port)"
  read -r -p "   Username [$default_user]: " user || true
  user="${user:-$default_user}"
  if [[ -z "$user" ]]; then
    echo "Error: username cannot be empty." >&2
    return 1
  fi

  while true; do
    read -r -s -p "   Password: " pass || true
    echo
    if [[ -z "$pass" ]]; then
      echo "   Password cannot be empty." >&2
      continue
    fi
    if ((${#pass} < 8)); then
      echo "   Use at least 8 characters." >&2
      continue
    fi
    read -r -s -p "   Confirm password: " pass2 || true
    echo
    if [[ "$pass" != "$pass2" ]]; then
      echo "   Passwords do not match. Try again." >&2
      continue
    fi
    break
  done

  INSTANCE_DASH_BASIC_USER="$user"
  INSTANCE_DASH_BASIC_PASSWORD="$pass"
  if [[ -z "$INSTANCE_DASH_BASIC_SECRET" ]]; then
    INSTANCE_DASH_BASIC_SECRET="$(generate_dashboard_secret)"
  fi
  return 0
}

# Populated by load_gateway_instance / used by recreate_gateway_instance.
INSTANCE_DATA_MOUNT=""
INSTANCE_GW_HOST_IP=""
INSTANCE_GW_HOST_PORT=""
INSTANCE_DASH_ENABLED=0
INSTANCE_DASH_TUI=0
# Auth mode: basic | oauth | insecure (legacy / explicit --insecure)
INSTANCE_DASH_AUTH=""
INSTANCE_DASH_BASIC_USER=""
INSTANCE_DASH_BASIC_PASSWORD=""
INSTANCE_DASH_BASIC_SECRET=""
INSTANCE_DASH_HOST_IP=""
INSTANCE_DASH_HOST_PORT=""
INSTANCE_DOCKER_ENV=()

# Read gateway container settings needed to recreate it (ports, data, dashboard, UID/GID).
load_gateway_instance() {
  local n="$1"
  local port_line dash_port_line env_line val

  port_line="$(docker port "$n" 8642/tcp 2>/dev/null | head -n1 || true)"
  if [[ -z "$port_line" ]]; then
    echo "Error: container '$n' has no published port for container 8642/tcp." >&2
    echo "       This does not look like a hermes-spawn gateway container." >&2
    return 1
  fi
  INSTANCE_GW_HOST_IP="${port_line%:*}"
  INSTANCE_GW_HOST_PORT="${port_line##*:}"

  INSTANCE_DATA_MOUNT="$(docker inspect --format '{{range .Mounts}}{{if eq .Destination "/opt/data"}}{{.Source}}{{end}}{{end}}' "$n" 2>/dev/null || true)"
  if [[ -z "$INSTANCE_DATA_MOUNT" ]]; then
    echo "Error: container '$n' has no bind mount at /opt/data." >&2
    return 1
  fi
  if [[ ! -d "$INSTANCE_DATA_MOUNT" ]]; then
    echo "Error: data directory '$INSTANCE_DATA_MOUNT' from container mount is missing on the host." >&2
    return 1
  fi

  INSTANCE_DASH_ENABLED=0
  INSTANCE_DASH_TUI=0
  INSTANCE_DASH_AUTH=""
  INSTANCE_DASH_BASIC_USER=""
  INSTANCE_DASH_BASIC_PASSWORD=""
  INSTANCE_DASH_BASIC_SECRET=""
  INSTANCE_DASH_HOST_IP=""
  INSTANCE_DASH_HOST_PORT=""
  INSTANCE_DOCKER_ENV=()

  dash_port_line="$(docker port "$n" 9119/tcp 2>/dev/null | head -n1 || true)"
  if [[ -n "$dash_port_line" ]]; then
    INSTANCE_DASH_HOST_IP="${dash_port_line%:*}"
    INSTANCE_DASH_HOST_PORT="${dash_port_line##*:}"
    INSTANCE_DASH_ENABLED=1
  fi

  local auth_label="" oauth_label="" insecure_env_val="" has_insecure_env=0
  auth_label="$(docker inspect --format '{{index .Config.Labels "hermes-spawn.dashboard.auth"}}' "$n" 2>/dev/null || true)"
  oauth_label="$(docker inspect --format '{{index .Config.Labels "hermes-spawn.dashboard.oauth"}}' "$n" 2>/dev/null || true)"

  while IFS= read -r env_line; do
    case "$env_line" in
    HERMES_UID=* | HERMES_GID=*)
      INSTANCE_DOCKER_ENV+=(-e "$env_line")
      ;;
    HERMES_DASHBOARD=*)
      val="${env_line#HERMES_DASHBOARD=}"
      if env_truthy "$val"; then
        INSTANCE_DASH_ENABLED=1
      fi
      ;;
    HERMES_DASHBOARD_TUI=*)
      val="${env_line#HERMES_DASHBOARD_TUI=}"
      if env_truthy "$val"; then
        INSTANCE_DASH_TUI=1
      fi
      ;;
    HERMES_DASHBOARD_INSECURE=*)
      has_insecure_env=1
      insecure_env_val="${env_line#HERMES_DASHBOARD_INSECURE=}"
      ;;
    HERMES_DASHBOARD_BASIC_AUTH_USERNAME=*)
      INSTANCE_DASH_BASIC_USER="${env_line#HERMES_DASHBOARD_BASIC_AUTH_USERNAME=}"
      ;;
    HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=*)
      INSTANCE_DASH_BASIC_PASSWORD="${env_line#HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=}"
      ;;
    HERMES_DASHBOARD_BASIC_AUTH_SECRET=*)
      INSTANCE_DASH_BASIC_SECRET="${env_line#HERMES_DASHBOARD_BASIC_AUTH_SECRET=}"
      ;;
    esac
  done < <(docker inspect --format '{{range .Config.Env}}{{println .}}{{end}}' "$n" 2>/dev/null || true)

  if [[ "$auth_label" == "basic" || "$auth_label" == "oauth" || "$auth_label" == "insecure" ]]; then
    INSTANCE_DASH_AUTH="$auth_label"
  elif [[ "$oauth_label" == "1" ]]; then
    INSTANCE_DASH_AUTH="oauth"
  elif [[ -n "$INSTANCE_DASH_BASIC_USER" && -n "$INSTANCE_DASH_BASIC_PASSWORD" ]]; then
    INSTANCE_DASH_AUTH="basic"
  elif ((has_insecure_env)) && env_truthy "$insecure_env_val"; then
    INSTANCE_DASH_AUTH="insecure"
  elif ((INSTANCE_DASH_ENABLED)); then
    # Legacy hermes-spawn dashboards defaulted to INSECURE=1.
    INSTANCE_DASH_AUTH="insecure"
  fi

  return 0
}

# Start a gateway container (container must not already exist).
# Dashboard auth uses INSTANCE_DASH_AUTH + INSTANCE_DASH_BASIC_* globals.
start_gateway_instance() {
  local n="$1" image="$2"
  local dash_enabled="${3:-0}" dash_tui="${4:-0}"
  local dash_host_ip="${5:-}" dash_host_port="${6:-}"
  local run_args=()

  run_args=(
    -d
    --name "$n"
    --restart unless-stopped
  )
  if ((${#INSTANCE_DOCKER_ENV[@]})); then
    run_args+=("${INSTANCE_DOCKER_ENV[@]}")
  fi
  if ((dash_enabled)); then
    run_args+=(-e HERMES_DASHBOARD=1)
    if ((dash_tui)); then
      run_args+=(-e HERMES_DASHBOARD_TUI=1)
    fi
    case "${INSTANCE_DASH_AUTH:-basic}" in
    basic)
      if [[ -z "$INSTANCE_DASH_BASIC_USER" || -z "$INSTANCE_DASH_BASIC_PASSWORD" ]]; then
        echo "Error: dashboard basic auth is incomplete (missing username/password)." >&2
        return 1
      fi
      run_args+=(-e "HERMES_DASHBOARD_BASIC_AUTH_USERNAME=$INSTANCE_DASH_BASIC_USER")
      run_args+=(-e "HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=$INSTANCE_DASH_BASIC_PASSWORD")
      if [[ -n "$INSTANCE_DASH_BASIC_SECRET" ]]; then
        run_args+=(-e "HERMES_DASHBOARD_BASIC_AUTH_SECRET=$INSTANCE_DASH_BASIC_SECRET")
      fi
      run_args+=(--label hermes-spawn.dashboard.auth=basic)
      run_args+=(--label hermes-spawn.dashboard.oauth=0)
      ;;
    oauth)
      run_args+=(--label hermes-spawn.dashboard.auth=oauth)
      run_args+=(--label hermes-spawn.dashboard.oauth=1)
      ;;
    insecure)
      run_args+=(-e HERMES_DASHBOARD_INSECURE=1)
      run_args+=(--label hermes-spawn.dashboard.auth=insecure)
      run_args+=(--label hermes-spawn.dashboard.oauth=0)
      ;;
    *)
      echo "Error: unknown dashboard auth mode '${INSTANCE_DASH_AUTH}'." >&2
      return 1
      ;;
    esac
  fi
  run_args+=(
    -v "$INSTANCE_DATA_MOUNT:/opt/data"
    -p "${INSTANCE_GW_HOST_IP}:${INSTANCE_GW_HOST_PORT}:8642"
  )
  if ((dash_enabled)) && [[ -n "$dash_host_ip" ]] && [[ -n "$dash_host_port" ]]; then
    run_args+=(-p "${dash_host_ip}:${dash_host_port}:9119")
  fi

  docker run "${run_args[@]}" "$image" gateway run >/dev/null
}

# Recreate a gateway container; preserves dashboard settings when dash_enabled=1.
recreate_gateway_instance() {
  local n="$1" image="$2"
  local dash_enabled="${3:-0}"
  local dash_host_port="${6:-}"
  local existing_dash=""

  # Fail before destroying the container if a *new* dashboard port is taken.
  if ((dash_enabled)) && [[ -n "$dash_host_port" ]]; then
    existing_dash="$(docker port "$n" 9119/tcp 2>/dev/null | head -n1 || true)"
    if [[ -z "$existing_dash" ]] && host_port_is_busy "$dash_host_port"; then
      echo "Error: host port $dash_host_port is already in use." >&2
      echo "       Free it, then retry (or pick another free port)." >&2
      return 1
    fi
  fi

  docker rm -f "$n" >/dev/null
  start_gateway_instance "$@"
}

# =========================================================================
# Subcommand: remove
# =========================================================================

sub_remove() {
  if [[ $# -lt 2 ]]; then
    echo "Error: $0 remove: missing <name>." >&2
    usage_spawn
  fi
  local n="$2"
  local keep=0
  local auto_yes=0
  shift 2
  for a; do
    case "$a" in
    --keep-data) keep=1 ;;
    -y | --yes)  auto_yes=1 ;;
    *) echo "Error: $0 remove: unknown option: $a" >&2; return 1 ;;
    esac
  done
  if ! [[ "$n" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
    echo "Error: name must be lowercase letters, numbers, or hyphens (and start with a letter/number)." >&2
    return 1
  fi

  local DATA_DIR
  DATA_DIR="$(resolve_data_dir "$n")"
  local BASHRC="$HOME/.bashrc"
  local cmt="# hermes-spawn: alias for '$n' container"
  local aline_new="alias ${n}='docker exec -it --user hermes ${n} /opt/hermes/.venv/bin/hermes'"
  local aline_old="alias ${n}='docker exec -it ${n} /opt/hermes/.venv/bin/hermes'"

  local has_dock=0 has_d=0 has_b=0
  if command -v docker &>/dev/null && docker ps -a --format '{{.Names}}' 2>/dev/null | grep -qx "$n"; then
    has_dock=1
  fi
  if [[ -e "$DATA_DIR" ]]; then has_d=1; fi
  if [[ -f "$BASHRC" ]]; then
    if grep -qF "$cmt" "$BASHRC" 2>/dev/null \
       || grep -qFx "$aline_new" "$BASHRC" 2>/dev/null \
       || grep -qFx "$aline_old" "$BASHRC" 2>/dev/null; then
      has_b=1
    fi
  fi

  if ! ((has_dock || has_d || has_b)); then
    echo "Error: no instance '$n' to remove." >&2
    echo "       (no container, no data at $HOME/hermes-spawn/$n or $HOME/.$n, no hermes-spawn block in $BASHRC)" >&2
    return 1
  fi

  if ((has_d)) && ((!keep)) && [[ -d "$DATA_DIR" ]] && [[ -n $(ls -A "$DATA_DIR" 2>/dev/null) ]] && ((!auto_yes)) && ! [[ -t 0 ]]; then
    echo "Error: non-interactive: pass -y to delete data, or use --keep-data" >&2
    return 1
  fi

  if ((has_dock)); then
    echo ">> Removing container '$n'..."
    docker rm -f "$n" >/dev/null
  fi

  if ((has_b)); then
    echo ">> Cleaning hermes-spawn lines in $BASHRC..."
    strip_hermes_bashrc_for_name "$n" "$BASHRC"
  fi

  if ((has_d)) && ((!keep)); then
    if ! [[ -d "$DATA_DIR" ]]; then
      :
    elif [[ -n "$(ls -A "$DATA_DIR" 2>/dev/null)" ]]; then
      if ((auto_yes)); then
        echo ">> Removing $DATA_DIR ..."
        rm -rf -- "$DATA_DIR"
      elif [[ -t 0 ]]; then
        read -r -p "Delete $DATA_DIR (all instance data)? [y/N] " ans
        if [[ "$ans" =~ ^[yY] ]]; then
          echo ">> Removing $DATA_DIR ..."
          rm -rf -- "$DATA_DIR"
        else
          echo ">> Data kept at $DATA_DIR"
        fi
      fi
    else
      rmdir -- "$DATA_DIR" 2>/dev/null || rm -rf -- "$DATA_DIR" 2>/dev/null
    fi
  elif ((has_d)) && ((keep)); then
    echo ">> Data left in $DATA_DIR (--keep-data)"
  fi

  if ((has_b)); then
    echo ">> Done. Run  source $BASHRC  if you want this shell to forget the '$n' alias."
  else
    echo ">> Done."
  fi
  return 0
}

# =========================================================================
# Subcommand: update
# =========================================================================

sub_update() {
  if [[ $# -lt 2 ]]; then
    echo "Error: $0 update: missing <name>." >&2
    usage_spawn
  fi
  local n="$2"
  local image="$HERMES_IMAGE"
  local do_pull=1
  shift 2
  while [[ $# -gt 0 ]]; do
    case "$1" in
    --image)
      if [[ $# -lt 2 ]]; then
        echo "Error: $0 update: --image requires a value." >&2
        return 1
      fi
      image="$2"
      shift 2
      ;;
    --no-pull)
      do_pull=0
      shift
      ;;
    *)
      echo "Error: $0 update: unknown option: $1" >&2
      return 1
      ;;
    esac
  done

  if ! [[ "$n" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
    echo "Error: name must be lowercase letters, numbers, or hyphens (and start with a letter/number)." >&2
    return 1
  fi
  if ! command -v docker &>/dev/null; then
    echo "Error: docker is not installed or not in PATH." >&2
    return 1
  fi
  if ! docker ps -a --format '{{.Names}}' 2>/dev/null | grep -qx "$n"; then
    echo "Error: no Docker container named '$n' to update." >&2
    local data_dir
    data_dir="$(resolve_data_dir "$n")"
    if [[ -d "$data_dir" ]] && [[ -n "$(ls -A "$data_dir" 2>/dev/null)" ]] && hermes_data_dir_looks_valid "$data_dir"; then
      echo "       Found existing data at $data_dir — restore instead:  $0 restore $n" >&2
    else
      echo "       Spawn one first:  $0 $n" >&2
    fi
    return 1
  fi

  if ! load_gateway_instance "$n"; then
    return 1
  fi

  local expected_dir dash_host_ip dash_host_port
  expected_dir="$(resolve_data_dir "$n")"
  if [[ "$INSTANCE_DATA_MOUNT" != "$expected_dir" ]] && [[ -e "$expected_dir" ]]; then
    echo ">> Note: container data mount is $INSTANCE_DATA_MOUNT (expected $expected_dir); keeping mount as-is."
  fi

  dash_host_ip="$INSTANCE_DASH_HOST_IP"
  dash_host_port="$INSTANCE_DASH_HOST_PORT"

  if ((INSTANCE_DASH_ENABLED)); then
    case "${INSTANCE_DASH_AUTH}" in
    basic)
      if [[ -z "$INSTANCE_DASH_BASIC_USER" || -z "$INSTANCE_DASH_BASIC_PASSWORD" ]]; then
        echo "Error: dashboard on '$n' is missing basic-auth credentials." >&2
        echo "       Re-enable it interactively:  $0 dashboard $n --reset-auth" >&2
        return 1
      fi
      ;;
    oauth) ;;
    insecure)
      echo "Error: dashboard on '$n' still uses HERMES_DASHBOARD_INSECURE=1." >&2
      echo "       Current Hermes images ignore that flag and refuse to bind." >&2
      echo "       Fix with:  $0 dashboard $n" >&2
      echo "       (prompts for username/password), or:  $0 dashboard $n --oauth" >&2
      return 1
      ;;
    *)
      echo "Error: dashboard on '$n' has no usable auth provider." >&2
      echo "       Fix with:  $0 dashboard $n" >&2
      return 1
      ;;
    esac
  fi

  echo ">> Updating '$n'..."
  echo "   Image    : $image"
  echo "   Data dir : $INSTANCE_DATA_MOUNT"
  echo "   Gateway  : ${INSTANCE_GW_HOST_IP}:${INSTANCE_GW_HOST_PORT}  (host -> container 8642)"
  if ((INSTANCE_DASH_ENABLED)); then
    echo "   Dashboard: ${dash_host_ip}:${dash_host_port}  (host -> container 9119)"
    if ((INSTANCE_DASH_TUI)); then
      echo "   Chat tab : enabled"
    fi
    case "${INSTANCE_DASH_AUTH}" in
    basic) echo "   Dashboard auth: username/password (user: $INSTANCE_DASH_BASIC_USER)" ;;
    oauth) echo "   Dashboard auth: Hermes OAuth gate" ;;
    esac
  fi
  echo

  if ((do_pull)); then
    echo ">> Pulling $image ..."
    docker pull "$image"
  else
    echo ">> Skipping pull (--no-pull)."
  fi

  echo ">> Recreating container '$n'..."
  recreate_gateway_instance "$n" "$image" "$INSTANCE_DASH_ENABLED" "$INSTANCE_DASH_TUI" "$dash_host_ip" "$dash_host_port"

  cat <<EOF

✓ '$n' updated and running.

  Container : $n
  Image     : $image
  Data dir  : $INSTANCE_DATA_MOUNT
  Gateway   : ${INSTANCE_GW_HOST_IP}:${INSTANCE_GW_HOST_PORT}
EOF
  if ((INSTANCE_DASH_ENABLED)); then
    cat <<EOF
  Dashboard : http://${dash_host_ip}:${dash_host_port}
EOF
  fi
  cat <<EOF

Docker commands:
  docker logs -f $n    # tail gateway logs
  $0 update $n         # pull latest and recreate again

EOF
  return 0
}

# =========================================================================
# Subcommand: dashboard
# =========================================================================

sub_dashboard() {
  if [[ $# -lt 2 ]]; then
    echo "Error: $0 dashboard: missing <name>." >&2
    usage_spawn
  fi
  local n="$2"
  local disable=0
  local no_tui=0
  local oauth=0
  local insecure=0
  local reset_auth=0
  shift 2
  while [[ $# -gt 0 ]]; do
    case "$1" in
    --disable)    disable=1 ;;
    --no-tui)     no_tui=1 ;;
    --oauth)      oauth=1 ;;
    --insecure)   insecure=1 ;;
    --reset-auth) reset_auth=1 ;;
    *)
      echo "Error: $0 dashboard: unknown option: $1" >&2
      return 1
      ;;
    esac
    shift
  done

  if ((disable)) && { ((no_tui)) || ((oauth)) || ((insecure)) || ((reset_auth)); }; then
    echo "Error: $0 dashboard: --disable cannot be combined with other dashboard options." >&2
    return 1
  fi
  if ((oauth)) && ((insecure)); then
    echo "Error: $0 dashboard: --oauth and --insecure cannot be combined." >&2
    return 1
  fi
  if ((reset_auth)) && { ((oauth)) || ((insecure)); }; then
    echo "Error: $0 dashboard: --reset-auth only applies to username/password auth (default)." >&2
    return 1
  fi

  if ! [[ "$n" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
    echo "Error: name must be lowercase letters, numbers, or hyphens (and start with a letter/number)." >&2
    return 1
  fi
  if ! command -v docker &>/dev/null; then
    echo "Error: docker is not installed or not in PATH." >&2
    return 1
  fi
  if ! docker ps -a --format '{{.Names}}' 2>/dev/null | grep -qx "$n"; then
    echo "Error: no Docker container named '$n'." >&2
    local data_dir
    data_dir="$(resolve_data_dir "$n")"
    if [[ -d "$data_dir" ]] && [[ -n "$(ls -A "$data_dir" 2>/dev/null)" ]] && hermes_data_dir_looks_valid "$data_dir"; then
      echo "       Found existing data at $data_dir — restore instead:  $0 restore $n" >&2
    else
      echo "       Spawn one first:  $0 $n" >&2
    fi
    return 1
  fi

  if ! load_gateway_instance "$n"; then
    return 1
  fi

  local loaded_auth="$INSTANCE_DASH_AUTH"
  local dash_enabled=0
  local dash_tui=0
  local dash_auth=""
  local dash_host_ip="$INSTANCE_DASH_HOST_IP"
  local dash_host_port="$INSTANCE_DASH_HOST_PORT"
  local prompted=0

  if ((disable)); then
    if ! ((INSTANCE_DASH_ENABLED)); then
      echo ">> Dashboard is not enabled on '$n'. Nothing to do."
      return 0
    fi
    dash_enabled=0
    dash_tui=0
    dash_auth=""
    INSTANCE_DASH_AUTH=""
    INSTANCE_DASH_BASIC_USER=""
    INSTANCE_DASH_BASIC_PASSWORD=""
    INSTANCE_DASH_BASIC_SECRET=""
    dash_host_ip=""
    dash_host_port=""
    echo ">> Disabling dashboard on '$n'..."
  else
    dash_enabled=1
    if ((no_tui)); then
      dash_tui=0
    else
      dash_tui=1
    fi

    if ((oauth)); then
      dash_auth="oauth"
    elif ((insecure)); then
      dash_auth="insecure"
      echo ">> Warning: HERMES_DASHBOARD_INSECURE=1 is a deprecated no-op on current Hermes images."
      echo "   Prefer the default username/password prompt unless you know you need this escape hatch."
      echo
    else
      dash_auth="basic"
    fi

    if [[ -z "$dash_host_ip" || -z "$dash_host_port" ]]; then
      dash_host_ip="127.0.0.1"
      dash_host_port="$(find_free_host_port 9119)"
    fi

    # Already configured the same way — nothing to do.
    if ((INSTANCE_DASH_ENABLED)) \
       && ((INSTANCE_DASH_TUI == dash_tui)) \
       && [[ "$loaded_auth" == "$dash_auth" ]] \
       && ! ((reset_auth)) \
       && { [[ "$dash_auth" != "basic" ]] || [[ -n "$INSTANCE_DASH_BASIC_USER" && -n "$INSTANCE_DASH_BASIC_PASSWORD" ]]; }; then
      echo ">> Dashboard already enabled on '$n'."
      echo "   Gateway   : ${INSTANCE_GW_HOST_IP}:${INSTANCE_GW_HOST_PORT}"
      echo "   Dashboard : http://${dash_host_ip}:${dash_host_port}"
      if ((dash_tui)); then
        echo "   Chat tab  : enabled"
      else
        echo "   Chat tab  : disabled (omit --no-tui to enable)"
      fi
      case "$dash_auth" in
      basic)    echo "   Auth      : username/password (user: $INSTANCE_DASH_BASIC_USER)" ;;
      oauth)    echo "   Auth      : Hermes OAuth gate" ;;
      insecure) echo "   Auth      : HERMES_DASHBOARD_INSECURE=1 (deprecated)" ;;
      esac
      if [[ "$dash_auth" == "basic" ]]; then
        echo "   Reset     : $0 dashboard $n --reset-auth"
      fi
      return 0
    fi

    INSTANCE_DASH_AUTH="$dash_auth"
    if [[ "$dash_auth" == "basic" ]]; then
      if ((reset_auth)) || [[ -z "$INSTANCE_DASH_BASIC_USER" || -z "$INSTANCE_DASH_BASIC_PASSWORD" ]]; then
        if ((reset_auth)); then
          INSTANCE_DASH_BASIC_PASSWORD=""
        fi
        if ! prompt_dashboard_basic_auth; then
          return 1
        fi
        prompted=1
      fi
    else
      INSTANCE_DASH_BASIC_USER=""
      INSTANCE_DASH_BASIC_PASSWORD=""
      INSTANCE_DASH_BASIC_SECRET=""
    fi

    echo ">> Enabling dashboard on '$n'..."
  fi

  echo "   Data dir : $INSTANCE_DATA_MOUNT"
  echo "   Gateway  : ${INSTANCE_GW_HOST_IP}:${INSTANCE_GW_HOST_PORT}  (host -> container 8642)"
  if ((dash_enabled)); then
    echo "   Dashboard: ${dash_host_ip}:${dash_host_port}  (host -> container 9119)"
    if ((dash_tui)); then
      echo "   Chat tab : enabled (HERMES_DASHBOARD_TUI=1)"
    else
      echo "   Chat tab : disabled"
    fi
    case "$dash_auth" in
    basic)    echo "   Auth     : username/password (user: $INSTANCE_DASH_BASIC_USER)" ;;
    oauth)    echo "   Auth     : Hermes OAuth gate (--oauth)" ;;
    insecure) echo "   Auth     : HERMES_DASHBOARD_INSECURE=1 (--insecure, deprecated)" ;;
    esac
  fi
  echo

  echo ">> Recreating container '$n'..."
  recreate_gateway_instance "$n" "$HERMES_IMAGE" "$dash_enabled" "$dash_tui" "$dash_host_ip" "$dash_host_port"

  if ((dash_enabled)); then
    cat <<EOF

✓ Dashboard enabled on '$n'.

  Container : $n
  Data dir  : $INSTANCE_DATA_MOUNT
  Gateway   : ${INSTANCE_GW_HOST_IP}:${INSTANCE_GW_HOST_PORT}
  Dashboard : http://${dash_host_ip}:${dash_host_port}
EOF
    if ((dash_tui)); then
      echo "  Chat tab  : open the Dashboard URL and use the Chat tab in your browser"
    fi
    case "$dash_auth" in
    basic)
      if ((prompted)); then
        echo "  Auth      : sign in as '$INSTANCE_DASH_BASIC_USER' with the password you just set"
      else
        echo "  Auth      : sign in as '$INSTANCE_DASH_BASIC_USER' (existing password kept)"
      fi
      echo "  Reset     : $0 dashboard $n --reset-auth"
      ;;
    oauth)
      echo "  Auth      : Hermes OAuth gate (set HERMES_DASHBOARD_OAUTH_CLIENT_ID if required)"
      ;;
    insecure)
      echo "  Auth      : HERMES_DASHBOARD_INSECURE=1 (ignored on current Hermes images)"
      ;;
    esac
    cat <<EOF

Docker commands:
  docker logs -f $n              # gateway + [dashboard] logs
  $0 dashboard $n --disable      # turn dashboard off
  $0 update $n                   # pull latest image (keeps dashboard settings)

EOF
  else
    cat <<EOF

✓ Dashboard disabled on '$n'.

  Container : $n
  Gateway   : ${INSTANCE_GW_HOST_IP}:${INSTANCE_GW_HOST_PORT}

  $0 dashboard $n                # enable again

EOF
  fi
  return 0
}

# =========================================================================
# Subcommand: restore
# =========================================================================

sub_restore() {
  if [[ $# -ne 2 ]]; then
    echo "Error: $0 restore: expected exactly one <name>." >&2
    usage_spawn
  fi
  local n="$2"
  local BASHRC="$HOME/.bashrc"
  local ALIAS_CMD="docker exec -it --user hermes ${n} /opt/hermes/.venv/bin/hermes"
  local ALIAS_LINE="alias ${n}='${ALIAS_CMD}'"

  if ! [[ "$n" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
    echo "Error: name must be lowercase letters, numbers, or hyphens (and start with a letter/number)." >&2
    return 1
  fi
  if ! command -v docker &>/dev/null; then
    echo "Error: docker is not installed or not in PATH." >&2
    return 1
  fi
  if docker ps -a --format '{{.Names}}' 2>/dev/null | grep -qx "$n"; then
    echo "Error: a Docker container named '$n' already exists." >&2
    echo "       Use  $0 update $n  to refresh the image, or  $0 remove $n  to tear it down." >&2
    return 1
  fi

  migrate_legacy_data_dir "$n"
  local DATA_DIR
  DATA_DIR="$(resolve_data_dir "$n")"
  if [[ ! -d "$DATA_DIR" ]] || [[ -z "$(ls -A "$DATA_DIR" 2>/dev/null)" ]]; then
    echo "Error: no existing data to restore for '$n'." >&2
    echo "       Expected a non-empty directory at $HOME/hermes-spawn/$n (or legacy $HOME/.$n)." >&2
    echo "       Create a new instance instead:  $0 $n" >&2
    return 1
  fi
  if ! hermes_data_dir_looks_valid "$DATA_DIR"; then
    echo "Error: $DATA_DIR does not look like Hermes data (missing .env and config.yaml)." >&2
    echo "       Back it up if needed, then spawn fresh:  $0 $n" >&2
    return 1
  fi

  if command -v "$n" &>/dev/null; then
    local REAL_PATH
    REAL_PATH="$(command -v "$n")"
    echo "Error: '$n' already exists on PATH at $REAL_PATH. Nothing was changed." >&2
    echo "       Pick a different name or remove the conflicting binary." >&2
    return 1
  fi

  if grep -qE "^[[:space:]]*alias[[:space:]]+${n}=" "$BASHRC" 2>/dev/null \
     && ! bashrc_has_hermes_spawn_alias "$n" "$BASHRC"; then
    echo "Error: an unrelated alias named '$n' already exists in $BASHRC. Nothing was changed." >&2
    echo "       Remove it manually first." >&2
    return 1
  fi

  compute_hermes_env
  INSTANCE_DOCKER_ENV=()
  if [[ -n "$HERMES_UID_RESOLVED" ]]; then
    INSTANCE_DOCKER_ENV=(
      -e "HERMES_UID=$HERMES_UID_RESOLVED"
      -e "HERMES_GID=${HERMES_GID_RESOLVED:-$HERMES_UID_RESOLVED}"
    )
  fi
  INSTANCE_DATA_MOUNT="$DATA_DIR"
  INSTANCE_GW_HOST_IP="127.0.0.1"
  INSTANCE_GW_HOST_PORT="$(find_free_host_port 8642)"

  echo ">> Restoring '$n' from existing data..."
  echo "   Data dir : $DATA_DIR"
  echo "   Port     : ${INSTANCE_GW_HOST_IP}:${INSTANCE_GW_HOST_PORT}  (host -> container 8642)"
  if [[ -n "$HERMES_UID_RESOLVED" ]]; then
    echo "   UID/GID  : $HERMES_UID_RESOLVED:${HERMES_GID_RESOLVED:-$HERMES_UID_RESOLVED} (mapped)"
  fi
  echo "   Setup    : skipped (using existing config)"
  echo

  fix_hermes_data_ownership "$DATA_DIR" "$HERMES_IMAGE"

  echo ">> Starting gateway container '$n'..."
  start_gateway_instance "$n" "$HERMES_IMAGE" 0 0 "" ""

  if bashrc_has_hermes_spawn_alias "$n" "$BASHRC"; then
    echo ">> Alias already present in $BASHRC"
  else
    {
      echo ""
      echo "# hermes-spawn: alias for '$n' container"
      echo "$ALIAS_LINE"
    } >> "$BASHRC"
    echo ">> Alias added to $BASHRC"
  fi

  cat <<EOF

✓ '$n' restored and running.

  Container : $n
  Data dir  : $DATA_DIR
  Gateway   : ${INSTANCE_GW_HOST_IP}:${INSTANCE_GW_HOST_PORT}

Activate the alias in this shell (if newly added):

  source ~/.bashrc

Then:
  $n              # open interactive chat

Docker commands:
  docker logs -f $n       # tail gateway logs
  $0 dashboard $n         # enable web dashboard (not preserved across restore)
  $0 update $n            # pull latest image and recreate container

EOF
  return 0
}

# =========================================================================
# Subcommand routing
# =========================================================================

if [[ ${1-} == restore ]]; then
  if [[ $# -lt 2 ]]; then
    echo "Error: $0 restore: missing <name>." >&2
    usage_spawn
  fi
  sub_restore "$@"
  exit $?
fi

if [[ ${1-} == dashboard ]]; then
  if [[ $# -lt 2 ]]; then
    echo "Error: $0 dashboard: missing <name>." >&2
    usage_spawn
  fi
  sub_dashboard "$@"
  exit $?
fi

if [[ ${1-} == update ]]; then
  if [[ $# -lt 2 ]]; then
    echo "Error: $0 update: missing <name>." >&2
    usage_spawn
  fi
  sub_update "$@"
  exit $?
fi

if [[ ${1-} == remove || ${1-} == rm ]]; then
  if [[ $# -lt 2 ]]; then
    echo "Error: $0 remove: missing <name>." >&2
    usage_spawn
  fi
  sub_remove "$@"
  exit $?
fi

# =========================================================================
# Subcommand: create (default)
# =========================================================================

if [[ $# -ne 1 ]]; then
  usage_spawn
fi

NAME="$1"
DATA_DIR="$HOME/hermes-spawn/$NAME"
BASHRC="$HOME/.bashrc"
# Run docker exec as the hermes user (UID 10000 inside the container), not
# root. If we run as root, any files the user creates via this alias (e.g.
# from `<name> gateway setup`) end up owned by root, then the gateway can't
# write to them after dropping privileges → crash loop.
ALIAS_CMD="docker exec -it --user hermes ${NAME} /opt/hermes/.venv/bin/hermes"
ALIAS_LINE="alias ${NAME}='${ALIAS_CMD}'"

# Resolve UID/GID mapping for the container's hermes user.
compute_hermes_env
DOCKER_HERMES_ENV=()
if [[ -n "$HERMES_UID_RESOLVED" ]]; then
  DOCKER_HERMES_ENV=(
    -e "HERMES_UID=$HERMES_UID_RESOLVED"
    -e "HERMES_GID=${HERMES_GID_RESOLVED:-$HERMES_UID_RESOLVED}"
  )
fi

# =========================================================================
# 2. PREFLIGHT CHECKS — nothing is created or modified until ALL pass
# =========================================================================

# --- 2a. name format -----------------------------------------------------
if ! [[ "$NAME" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
  echo "Error: name must be lowercase letters, numbers, or hyphens (and start with a letter/number)." >&2
  exit 1
fi

# --- 2b. reserved names ---------------------------------------------------
RESERVED_NAMES=(
  remove rm update restore dashboard
  ls cd cp mv mkdir rmdir cat grep sed awk find sudo su
  bash sh zsh fish docker apt yum dnf systemctl service
  git python python3 node npm pip curl wget ssh scp
  test echo printf which type alias unalias source export
  kill killall ps top htop nano vim emacs
  hermes-spawn
)
for r in "${RESERVED_NAMES[@]}"; do
  if [[ "$NAME" == "$r" ]]; then
    echo "Error: '$NAME' is a reserved name (would shadow a system command)." >&2
    echo "       Pick something else, e.g. ${NAME}-bot or my-${NAME}." >&2
    exit 1
  fi
done

# --- 2c. docker available -------------------------------------------------
if ! command -v docker &>/dev/null; then
  echo "Error: docker is not installed or not in PATH." >&2
  exit 1
fi

# --- 2d. container name not taken ----------------------------------------
if docker ps -a --format '{{.Names}}' | grep -qx "$NAME"; then
  echo "Error: a Docker container named '$NAME' already exists. Nothing was changed." >&2
  echo "       Inspect:  docker ps -a --filter name=^${NAME}\$" >&2
  echo "       Remove:   $0 remove $NAME" >&2
  exit 1
fi

# --- 2e. data directory not in use ---------------------------------------
# Check both new and legacy locations. Legacy will be auto-migrated below
# (only if container/alias don't exist), so empty/missing is fine here.
LEGACY_DIR="$HOME/.$NAME"
for d in "$DATA_DIR" "$LEGACY_DIR"; do
  if [[ -e "$d" ]] && [[ -n "$(ls -A "$d" 2>/dev/null)" ]]; then
    echo "Error: $d already exists and is not empty. Nothing was changed." >&2
    echo "       A previous '$NAME' instance probably left data behind." >&2
    echo "       Options:" >&2
    echo "         - Restore it:  $0 restore $NAME" >&2
    echo "         - Pick a different name." >&2
    echo "         - Back it up:  mv $d ${d}.bak" >&2
    echo "         - Wipe it:     rm -rf $d" >&2
    exit 1
  fi
done

# --- 2f. alias name not already in ~/.bashrc -----------------------------
if grep -qE "^[[:space:]]*alias[[:space:]]+${NAME}=" "$BASHRC" 2>/dev/null; then
  echo "Error: an alias named '$NAME' already exists in $BASHRC. Nothing was changed." >&2
  echo "       Remove it manually first, or run:  $0 remove $NAME" >&2
  exit 1
fi

# --- 2g. name not already a real binary on PATH --------------------------
if command -v "$NAME" &>/dev/null; then
  REAL_PATH="$(command -v "$NAME")"
  echo "Error: '$NAME' already exists on PATH at $REAL_PATH. Nothing was changed." >&2
  echo "       The alias would shadow it. Pick a different name." >&2
  exit 1
fi

# --- 2h. find a free host port (start at 8642) ---------------------------
PORT="$(find_free_host_port 8642)"

# =========================================================================
# 3. ALL CHECKS PASSED — now actually do things
# =========================================================================

echo ">> All checks passed. Setting up '$NAME'..."
echo "   Data dir : $DATA_DIR"
echo "   Port     : 127.0.0.1:$PORT  (host -> container 8642)"
if [[ -n "$HERMES_UID_RESOLVED" ]]; then
  echo "   UID/GID  : $HERMES_UID_RESOLVED:${HERMES_GID_RESOLVED:-$HERMES_UID_RESOLVED} (mapped)"
else
  echo "   UID/GID  : default (running as root; using world-writable data dir)"
fi
echo

# --- 3a. data dir: migrate from legacy if present, else create -----------
migrate_legacy_data_dir "$NAME"
mkdir -p "$DATA_DIR"

# Set permissions. With HERMES_UID mapping the container user to the host
# user, the bind mount works correctly with restrictive perms (700/755).
# Without that mapping, we fall back to 777 so the dropped-privileges user
# inside the container can still write.
if [[ -n "$HERMES_UID_RESOLVED" ]]; then
  chmod 700 "$DATA_DIR"
else
  chmod -R 777 "$DATA_DIR"
fi

# --- 3b. interactive setup wizard ----------------------------------------
echo
echo "================================================================"
echo " IMPORTANT: Use a UNIQUE bot token for this instance."
echo " Don't reuse Telegram/Discord/WhatsApp/Slack tokens across"
echo " instances — Hermes will refuse to start the gateway if two"
echo " instances try to share the same bot token."
echo "================================================================"
echo
docker run -it --rm \
  "${DOCKER_HERMES_ENV[@]}" \
  -v "$DATA_DIR:/opt/data" \
  "$HERMES_IMAGE" setup

# --- 3b-post. fix ownership on anything the wizard left as root ----------
# The Hermes image's entrypoint chowns most of /opt/data to the hermes user
# (UID 10000), but some platform-specific dirs (notably whatsapp/, and
# .env) get created later as root and aren't fixed up. The gateway then
# drops privileges to UID 10000 and can't write to those files. We fix it
# here in a throwaway root-mode container.
echo
fix_hermes_data_ownership "$DATA_DIR" "$HERMES_IMAGE"

# --- 3c. start gateway ---------------------------------------------------
echo
echo ">> Starting gateway container '$NAME' on 127.0.0.1:$PORT..."
docker run -d \
  --name "$NAME" \
  --restart unless-stopped \
  "${DOCKER_HERMES_ENV[@]}" \
  -v "$DATA_DIR:/opt/data" \
  -p "127.0.0.1:${PORT}:8642" \
  "$HERMES_IMAGE" gateway run > /dev/null

# --- 3d. append alias ----------------------------------------------------
{
  echo ""
  echo "# hermes-spawn: alias for '$NAME' container"
  echo "$ALIAS_LINE"
} >> "$BASHRC"
echo ">> Alias added to $BASHRC"

# =========================================================================
# 4. DONE
# =========================================================================
cat <<EOF

✓ '$NAME' is running.

  Container : $NAME
  Data dir  : $DATA_DIR
  Port      : 127.0.0.1:$PORT

Activate the alias in this shell:

  source ~/.bashrc

Then:
  $NAME              # open interactive chat
  $NAME --help

Docker commands:
  docker logs -f $NAME    # tail gateway logs
  docker stop $NAME       # stop the gateway
  docker start $NAME      # start it again
  $0 restore $NAME        # recreate container from existing data (no setup)
  $0 dashboard $NAME      # enable web dashboard + browser chat tab
  $0 update $NAME         # pull latest image and recreate container
  $0 remove $NAME         # stop container, remove data + alias

EOF

exit 0
